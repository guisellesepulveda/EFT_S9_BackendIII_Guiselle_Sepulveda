<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 3.5.16 (última 3.5.x en Maven Central) + Spring Cloud 2025.0.3 "Northfields" (compatible con Boot 3.5.x).
       Ambos están fuera de soporte OSS según spring.io; ver docs/adr/ADR-001-versiones-spring.md -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>cl.bancoxyz.modernizacion</groupId>
  <artifactId>banco-xyz-modernizacion</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Banco XYZ - Modernización Backend</name>
  <description>EFT Desarrollo Backend III (PBY2203): Spring Cloud y Spring Batch</description>

  <modules>
    <!-- Librería compartida: contrato de eventos, outbox, idempotencia, seguridad, errores -->
    <module>libs/platform-common</module>
    <module>libs/bff-common</module>
    <!-- Infraestructura Spring Cloud -->
    <module>infra/config-server</module>
    <module>infra/discovery-server</module>
    <module>infra/api-gateway</module>
    <module>infra/auth-server</module>
    <!-- Microservicios -->
    <module>services/customers-service</module>
    <module>services/accounts-service</module>
    <module>services/payments-service</module>
    <!-- Backend for Frontend -->
    <module>bff/bff-web</module>
    <module>bff/bff-mobile</module>
    <module>bff/bff-atm</module>
    <!-- Batch -->
    <module>batch/batch-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.0.3</spring-cloud.version>
    <!-- springdoc 2.8.x es la línea para Spring Boot 3.x -->
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <build>
    <plugins>
      <!-- *Test = unitarios (mvn test); *IT = integración con Testcontainers (mvn verify) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>cl.bancoxyz.modernizacion</groupId>
        <artifactId>platform-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>cl.bancoxyz.modernizacion</groupId>
        <artifactId>bff-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
