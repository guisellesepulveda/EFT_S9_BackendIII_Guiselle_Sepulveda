{
  "components" : {
    "schemas" : {
      "Account" : {
        "properties" : {
          "balance" : {
            "example" : 7499.5,
            "type" : "number"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "number" : {
            "example" : "CL1000000001",
            "type" : "string"
          },
          "type" : {
            "example" : "CHECKING",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Home" : {
        "properties" : {
          "accounts" : {
            "items" : {
              "$ref" : "#/components/schemas/Account"
            },
            "type" : "array"
          },
          "totalBalance" : {
            "example" : 9999.5,
            "type" : "number"
          }
        },
        "type" : "object"
      },
      "RefreshRequest" : {
        "properties" : {
          "refreshToken" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "refreshToken" ],
        "type" : "object"
      },
      "TokenRequest" : {
        "properties" : {
          "code" : {
            "minLength" : 1,
            "type" : "string"
          },
          "codeVerifier" : {
            "maxLength" : 128,
            "minLength" : 43,
            "type" : "string"
          },
          "redirectUri" : {
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [ "code", "codeVerifier", "redirectUri" ],
        "type" : "object"
      },
      "Tokens" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresIn" : {
            "format" : "int64",
            "type" : "integer"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "scope" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "Transfer" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "status" : {
            "example" : "PENDING",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "TransferRequest" : {
        "properties" : {
          "amount" : {
            "example" : 2500.5,
            "minimum" : 0.01,
            "type" : "number"
          },
          "from" : {
            "format" : "uuid",
            "type" : "string"
          },
          "note" : {
            "maxLength" : 100,
            "minLength" : 0,
            "type" : "string"
          },
          "to" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "amount", "from", "to" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
