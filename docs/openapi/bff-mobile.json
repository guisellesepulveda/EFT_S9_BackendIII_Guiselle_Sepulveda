        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Transfer"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Transferencia desde una cuenta propia (Idempotency-Key obligatoria). Responde 202 con id y estado",
        "tags" : [ "BFF móvil" ]
      }
    },
    "/mobile/transfers/{id}" : {
