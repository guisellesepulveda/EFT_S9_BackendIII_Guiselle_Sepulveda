        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Tokens"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Canjea el código de autorización (PKCE) por tokens; el BFF aporta el secreto del cliente confidencial",
        "tags" : [ "BFF móvil" ]
