# Copiar a `.env` con scripts/init-env.sh (reemplaza cada CHANGE_ME por un valor aleatorio) o a mano.
# Nunca commitear `.env` (está en .gitignore). En AWS estos valores viven en Secrets Manager.

# --- Perfiles de docker compose: apps = TODO (infra + apps) para que `docker compose up -d --build` levante la plataforma.
#     scripts/run-local.sh (apps en el host) usa COMPOSE_PROFILES=infra.
COMPOSE_PROFILES=apps

# --- PostgreSQL (database per service: una base y un usuario por servicio) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CUSTOMERS_DB_PASSWORD=CHANGE_ME
ACCOUNTS_DB_PASSWORD=CHANGE_ME
PAYMENTS_DB_PASSWORD=CHANGE_ME
BATCH_DB_PASSWORD=CHANGE_ME
ATM_DB_PASSWORD=CHANGE_ME

# --- Spring Cloud Config Server (protegido con usuario/contraseña) ---
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=CHANGE_ME

# --- Eureka (discovery) ---
EUREKA_USER=eureka
EUREKA_PASSWORD=CHANGE_ME

# --- Kafka (KRaft) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Solo AWS: <bootstrap servers MSK>

# --- Auth Server (OAuth2/OIDC): un cliente por canal + cliente interno ---
AUTH_ISSUER_URI=http://localhost:9000
WEB_CLIENT_SECRET=CHANGE_ME
MOBILE_CLIENT_SECRET=CHANGE_ME
ATM_CLIENT_SECRET=CHANGE_ME
INTERNAL_SERVICE_CLIENT_SECRET=CHANGE_ME
# Contraseñas de los usuarios de demostración: customer1, admin, batch-admin
DEMO_USER_PASSWORD=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
BATCH_ADMIN_PASSWORD=CHANGE_ME

# --- TLS (certificados de desarrollo generados por certs/generate-dev-certs.sh; Etapa 3) ---
KEYSTORE_PASSWORD=CHANGE_ME
TRUSTSTORE_PASSWORD=CHANGE_ME
# Solo AWS: <ARN certificado ACM>

# --- Observabilidad ---
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# --- AWS (solo documentación; nunca se ejecuta contra AWS) ---
# <ID de cuenta>
# <región>
# <endpoint RDS>
